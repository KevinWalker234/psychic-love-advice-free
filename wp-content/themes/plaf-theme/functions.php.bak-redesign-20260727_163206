<?php
if ( ! defined( 'ABSPATH' ) ) exit;
define( 'PLAF_VERSION', '1.0.0' );
define( 'PLAF_DIR', get_template_directory() );
define( 'PLAF_URI', get_template_directory_uri() );

function plaf_setup() {
    add_theme_support( 'title-tag' );
    add_theme_support( 'post-thumbnails' );
    add_theme_support( 'html5', array( 'search-form', 'comment-form', 'comment-list', 'gallery', 'caption', 'style', 'script' ) );
    add_theme_support( 'custom-logo', array( 'height' => 40, 'width' => 200, 'flex-height' => true, 'flex-width' => true ) );
    add_theme_support( 'customize-selective-refresh-widgets' );
    register_nav_menus( array( 'primary' => __( 'Primary Menu', 'plaf-theme' ), 'footer' => __( 'Footer Menu', 'plaf-theme' ) ) );
}
add_action( 'after_setup_theme', 'plaf_setup' );

function plaf_enqueue_assets() {
    wp_enqueue_style( 'plaf-fonts', 'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Lato:wght@300;400;700&display=swap', array(), null );
    wp_enqueue_style( 'plaf-style', get_stylesheet_uri(), array( 'plaf-fonts' ), PLAF_VERSION );
    wp_enqueue_script( 'plaf-nav', PLAF_URI . '/assets/js/navigation.js', array(), PLAF_VERSION, true );
}
add_action( 'wp_enqueue_scripts', 'plaf_enqueue_assets' );

function plaf_widgets_init() {
    register_sidebar( array( 'name' => __( 'Sidebar', 'plaf-theme' ), 'id' => 'plaf-sidebar', 'before_widget' => '<div id="%1$s" class="widget %2$s">', 'after_widget' => '</div>', 'before_title' => '<h3 class="widget-title">', 'after_title' => '</h3>' ) );
    register_sidebar( array( 'name' => __( 'Footer Widgets', 'plaf-theme' ), 'id' => 'plaf-footer', 'before_widget' => '<div id="%1$s" class="footer-widget %2$s">', 'after_widget' => '</div>', 'before_title' => '<h4 class="footer-widget-title">', 'after_title' => '</h4>' ) );
}
add_action( 'widgets_init', 'plaf_widgets_init' );

function plaf_excerpt_length( $length ) { return 24; }
add_filter( 'excerpt_length', 'plaf_excerpt_length' );
function plaf_excerpt_more( $more ) { return '&hellip;'; }
add_filter( 'excerpt_more', 'plaf_excerpt_more' );

require_once PLAF_DIR . '/inc/template-tags.php';
require_once PLAF_DIR . '/inc/customizer.php';

// --- wp-net-control: home SEO title override (no SEO plugin detected) ---
add_filter('pre_get_document_title', function($title) {
    if (is_front_page() || is_home()) {
        return 'Free Psychic Love Advice | Real Guidance on Relationships';
    }
    return $title;
}, 99);
// --- end wp-net-control ---
